{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./.test-dist",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "isolatedModules": false,
    "incremental": false
  },
  "include": [
    "tests/**/*.ts",
    "src/lib/authorization.ts",
    "src/lib/member-access.ts",
    "src/lib/generated-newsletter-schema.ts",
    "src/lib/outbound-url.ts",
    "src/lib/safe-url.ts",
    "src/types/integration.ts",
    "src/types/member.ts",
    "src/types/newsletter.ts"
  ]
}
